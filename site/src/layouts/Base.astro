---
import { ClientRouter } from 'astro:transitions'
// 霞鹜文楷（屏幕版，国标字形）。这个包把中文按 unicode-range 切成 388 个小块，
// 浏览器只下载页面上真正用到的那几块，所以标题用得起而正文不必背这个包袱。
import 'lxgw-wenkai-screen-webfont/lxgwwenkaigbscreen.css'
import '../styles/global.css'
import AmbientBackdrop from '../components/AmbientBackdrop.astro'
import SectionRail from '../components/SectionRail.astro'
import { SITE } from '../lib/site'

interface Props {
  title?: string
  description?: string
}

const { title, description = SITE.description } = Astro.props

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      给 <html> 打一个 js 标记。
      入场动画的初始态是 opacity:0，而 CSS 里写成 `.js [data-reveal]` ——
      只有这个脚本执行了才会生效。这样 JS 被禁用或加载失败时，
      内容不会被永久藏起来（这是个很容易踩的坑）。
    -->
    <script is:inline>document.documentElement.classList.add('js')</script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- 页面转场：点链接不再白屏重载，新旧页面之间做过渡 -->
    <ClientRouter />
  </head>

  <body>
    <!-- 全站的动态背景：缓慢流动的色雾 + 颗粒质感 -->
    <AmbientBackdrop />

    <header class="site-header" transition:name="site-header">
      <div class="container site-header__inner">
        <a class="site-title" href="/">{SITE.title}</a>
      </div>
    </header>

    <!-- 栏目的切换：首页靠空间里的面板（主路径），任何页面靠左边这条轨（兜底） -->
    <SectionRail />

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer" transition:name="site-footer">
      <div class="container site-footer__inner">
        <span>© {new Date().getFullYear()} {SITE.author || SITE.title}</span>
        <span>用 Astro 生成</span>
      </div>
    </footer>

    <script>
      /**
       * 滚动入场：带 [data-reveal] 的元素进入视口时上浮淡入。
       *
       * 用了 ClientRouter（页面转场）之后，模块脚本只在首次加载时执行一次，
       * 每次导航都要靠 astro:page-load 事件重新初始化。下面有幂等保护，
       * 所以首次加载两个事件都触发也不会重复处理。
       *
       * ⚠️ 这类"默认隐藏、靠 JS 放出来"的动画有个致命故障模式：JS 一旦不工作，
       *    内容就永久隐形。所以做了两道保险：
       *      1. 隐藏规则写成 `.js [data-reveal]`，.js 由 head 里的内联脚本添加；
       *         JS 被禁用时这个类不存在，内容正常显示。
       *      2. 观察器若在 2 秒内一次都没回调（说明它没在工作），
       *         直接把所有元素放出来。
       */
      function initReveal() {
        const nodes = Array.from(
          document.querySelectorAll('[data-reveal]:not([data-reveal-ready])'),
        )
        if (nodes.length === 0) return

        // 不支持观察器就什么都不做 —— 不隐藏就等于全部可见
        if (!('IntersectionObserver' in window)) return

        let hits = 0

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              hits += 1
              entry.target.classList.add('is-in')
              io.unobserve(entry.target)
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.04 },
        )

        for (const el of nodes) {
          el.setAttribute('data-reveal-ready', '')
          io.observe(el)
        }

        // 兜底：观察器完全没反应就把内容全部放出来。宁可没有动画，也不能没有内容。
        window.setTimeout(() => {
          if (hits > 0) return
          for (const el of nodes) el.classList.add('is-in')
        }, 2000)
      }

      document.addEventListener('astro:page-load', initReveal)
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReveal)
      } else {
        initReveal()
      }

      /**
       * 3D 倾斜：带 [data-tilt] 的元素跟着鼠标做透视旋转，做出"卡片有厚度"的感觉。
       *
       * 用 CSS 变量把角度写回去，由样式里的 transform 消费 —— 这样动画本身
       * 还是走 CSS（合成器层），JS 只负责改数值，不会卡。
       */
      function initTilt() {
        const nodes = document.querySelectorAll('[data-tilt]:not([data-tilt-ready])')
        // 触摸设备没有"悬停"这回事，做了只会显得怪
        if (!window.matchMedia('(hover: hover)').matches) return
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

        const MAX_DEG = 9

        for (const el of nodes) {
          el.setAttribute('data-tilt-ready', '')
          const node = /** @type {HTMLElement} */ (el)

          node.addEventListener('pointermove', (e) => {
            const r = node.getBoundingClientRect()
            const px = (e.clientX - r.left) / r.width - 0.5
            const py = (e.clientY - r.top) / r.height - 0.5
            node.style.setProperty('--rx', `${(-py * MAX_DEG).toFixed(2)}deg`)
            node.style.setProperty('--ry', `${(px * MAX_DEG).toFixed(2)}deg`)
            node.style.setProperty('--mx', `${((px + 0.5) * 100).toFixed(1)}%`)
            node.style.setProperty('--my', `${((py + 0.5) * 100).toFixed(1)}%`)
          })

          node.addEventListener('pointerleave', () => {
            node.style.setProperty('--rx', '0deg')
            node.style.setProperty('--ry', '0deg')
          })
        }
      }

      document.addEventListener('astro:page-load', initTilt)
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTilt)
      } else {
        initTilt()
      }
    </script>
  </body>
</html>
