---
/**
 * 光尘：首屏背后的粒子层。
 *
 * 设计意图是"空气感"，不是"科技感"——
 *   · 低密度（按面积算，24~70 个，屏幕越大越多但封顶）
 *   · 暖色、低透明度、极慢上浮，像阳光里的灰尘
 *   · 鼠标靠近时被轻轻推开，是唯一"有反应"的地方
 *   · 只在首屏。往下滚出视野就完全停止，不占 CPU
 *
 * 不引第三方粒子库（那类库动辄几十 KB，功能我们用不到 5%）。
 * 不用时完全不存在：JS 关了只是没有粒子，页面照常。
 */
---

<div class="dust" data-dust-root aria-hidden="true">
  <canvas class="dust__canvas" data-dust-canvas></canvas>
</div>

<script>
  const root = document.querySelector('[data-dust-root]')
  const canvas = document.querySelector('[data-dust-canvas]')

  // 用户明确表示不希望有动效时，一个粒子都不画
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)')

  if (root && canvas instanceof HTMLCanvasElement && !prefersReduced.matches) {
    initDust(root, canvas)
  }

  function initDust(rootEl, canvasEl) {
    const ctx = canvasEl.getContext('2d', { alpha: true })
    if (!ctx) return

    // 颜色从 CSS 变量取，跟着深浅色模式走
    const rgbRaw =
      getComputedStyle(document.documentElement).getPropertyValue('--dust-rgb').trim() ||
      '214 178 138'
    const [dr, dg, db] = rgbRaw.split(/\s+/).map(Number)

    /** 预渲染一颗柔和的尘粒贴图；每帧直接 drawImage，比画径向渐变快得多。 */
    function makeSprite() {
      const S = 64
      const c = document.createElement('canvas')
      c.width = c.height = S
      const g = c.getContext('2d')
      if (!g) return c
      const grad = g.createRadialGradient(S / 2, S / 2, 0, S / 2, S / 2, S / 2)
      grad.addColorStop(0, `rgba(${dr},${dg},${db},1)`)
      grad.addColorStop(0.4, `rgba(${dr},${dg},${db},0.3)`)
      grad.addColorStop(1, `rgba(${dr},${dg},${db},0)`)
      g.fillStyle = grad
      g.fillRect(0, 0, S, S)
      return c
    }
    const sprite = makeSprite()

    let W = 0
    let H = 0
    let motes = []
    let raf = 0
    let inView = true
    let tabVisible = !document.hidden
    const pointer = { x: -9999, y: -9999, active: false }

    function spawn(fromBottom) {
      return {
        x: Math.random() * W,
        y: fromBottom ? H + 20 : Math.random() * H,
        r: 0.7 + Math.random() * 1.9,
        vy: -(0.05 + Math.random() * 0.2),
        swayPhase: Math.random() * Math.PI * 2,
        swaySpeed: 0.0015 + Math.random() * 0.005,
        alpha: 0.1 + Math.random() * 0.3,
      }
    }

    function seed() {
      const target = Math.round((W * H) / 22000)
      const count = Math.max(24, Math.min(70, target))
      motes = Array.from({ length: count }, () => spawn(false))
    }

    function resize() {
      const rect = rootEl.getBoundingClientRect()
      if (rect.width === 0 || rect.height === 0) return
      const dpr = Math.min(window.devicePixelRatio || 1, 2)
      W = rect.width
      H = rect.height
      canvasEl.width = Math.round(W * dpr)
      canvasEl.height = Math.round(H * dpr)
      canvasEl.style.width = `${W}px`
      canvasEl.style.height = `${H}px`
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      seed()
    }

    const REPEL_RADIUS = 140

    function frame() {
      ctx.clearRect(0, 0, W, H)
      for (const m of motes) {
        m.swayPhase += m.swaySpeed
        m.y += m.vy
        m.x += Math.sin(m.swayPhase) * 0.22

        // 鼠标扰动：越近推得越明显，但幅度很小，只是"被拨开"
        if (pointer.active) {
          const dx = m.x - pointer.x
          const dy = m.y - pointer.y
          const d2 = dx * dx + dy * dy
          if (d2 < REPEL_RADIUS * REPEL_RADIUS && d2 > 0.5) {
            const d = Math.sqrt(d2)
            const push = (1 - d / REPEL_RADIUS) * 1.1
            m.x += (dx / d) * push
            m.y += (dy / d) * push
          }
        }

        if (m.y < -20) Object.assign(m, spawn(true))
        if (m.x < -20) m.x = W + 15
        else if (m.x > W + 20) m.x = -15

        const size = m.r * 9
        ctx.globalAlpha = m.alpha
        ctx.drawImage(sprite, m.x - size / 2, m.y - size / 2, size, size)
      }
      ctx.globalAlpha = 1
      raf = window.requestAnimationFrame(frame)
    }

    function start() {
      if (raf !== 0) return
      if (!inView || !tabVisible) return
      raf = window.requestAnimationFrame(frame)
    }

    function stop() {
      if (raf === 0) return
      window.cancelAnimationFrame(raf)
      raf = 0
    }

    // 滚出视野就停，别为一个看不见的东西烧电
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          inView = entries.some((e) => e.isIntersecting)
          if (inView) start()
          else stop()
        },
        { threshold: 0 },
      ).observe(rootEl)
    }

    document.addEventListener('visibilitychange', () => {
      tabVisible = !document.hidden
      if (tabVisible) start()
      else stop()
    })

    rootEl.addEventListener('pointermove', (e) => {
      const rect = rootEl.getBoundingClientRect()
      pointer.x = e.clientX - rect.left
      pointer.y = e.clientY - rect.top
      pointer.active = true
    })
    rootEl.addEventListener('pointerleave', () => {
      pointer.active = false
    })

    // 尺寸变化重建（用 rAF 合并抖动）
    let resizeRaf = 0
    window.addEventListener('resize', () => {
      if (resizeRaf) return
      resizeRaf = window.requestAnimationFrame(() => {
        resizeRaf = 0
        resize()
      })
    })

    resize()
    start()
  }
</script>
